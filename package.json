{
  "name": "terminal221b",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "cli": "npm run start --workspace @terminal221b/cli --",
    "build:cli": "npm run build --workspace @terminal221b/cli",
    "tui": "cargo run -p terminal221b-tui --",
    "build:tui": "cargo build --release -p terminal221b-tui",
    "lint:shell": "shellcheck packages/cli/resources/*.sh",
    "lint": "eslint App.tsx index.ts src packages/cli/src packages/cli/tests",
    "test": "vitest run",
    "test:components": "jest",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @terminal221b/cli",
    "typecheck:tests": "tsc -p packages/cli/tsconfig.test.json",
    "test:count": "./scripts/assert-test-count.sh 390",
    "build": "expo export --platform web"
  },
  "workspaces": [
    "packages/cli"
  ],
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoozeLee/terminal221b.git"
  },
  "homepage": "https://github.com/BoozeLee/terminal221b",
  "bugs": {
    "url": "https://github.com/BoozeLee/terminal221b/issues"
  },
  "overrides": {
    "postcss": "8.5.28",
    "image-size": "2.0.3",
    "uuid": "11.1.1"
  }
}
